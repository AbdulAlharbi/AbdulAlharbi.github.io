---
/**
 * Document shell for the main site: metadata, fonts, and the stylesheet.
 * Page-specific values come in as props; site-wide ones come from the data
 * layer, so nothing about the author is hard-coded here.
 */
import '../styles/global.css';
// The two faces used above the fold are preloaded (declared in styles/fonts.css).
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import plexSansUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import { getSite } from '../lib/content';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = await getSite();

// Absolute URLs: Open Graph scrapers reject relative image paths. With
// build.format "file" the index page's pathname is /index.html; the
// canonical form of the home page is the bare origin.
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const ogImage = new URL(site.meta.ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.meta.themeColor} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.meta.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts: Fraunces (editorial display serif), IBM Plex Sans (body), IBM Plex Mono (meta).
         The two faces used above the fold are preloaded; the rest arrive with the stylesheet. -->
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSansUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
