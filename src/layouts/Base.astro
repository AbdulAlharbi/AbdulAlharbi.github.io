---
/**
 * Document shell for the main site: metadata, fonts, and the stylesheet.
 * Page-specific values come in as props; site-wide ones come from the data
 * layer, so nothing about the author is hard-coded here.
 */
import '../styles/global.css';
import { getSite } from '../lib/content';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = await getSite();

// Absolute URLs: Open Graph scrapers reject relative image paths. With
// build.format "file" the index page's pathname is /index.html; the
// canonical form of the home page is the bare origin.
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const ogImage = new URL(site.meta.ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.meta.themeColor} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.meta.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: Fraunces (editorial display serif), IBM Plex Sans (body), IBM Plex Mono (meta) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
