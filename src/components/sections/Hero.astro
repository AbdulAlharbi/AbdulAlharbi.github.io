---
/** Page header: identity, lede, calls to action, portrait, thesis metrics. */
import './Hero.css';
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import MetricStrip from '../MetricStrip.astro';
import { getOrdered, getSite } from '../../lib/content';

const site = await getSite();
const thesis = (await getOrdered('research')).find((r) => r.data.featured);
if (!thesis?.data.featured) throw new Error('No featured research entry to draw hero metrics from');
const { hero, name, links, cta } = site;
---

<header id="top">
  <div class="hero">
    <div class="hero-inner">
      <div>
        <p class="hero-meta">
          <span class="dot" aria-hidden="true"></span>
          <span>{hero.status}</span>
        </p>

        <h1 class="serif">{name.given} <em>{name.family}</em>.</h1>

        <p class="hero-lede" set:html={hero.lede} />

        <div class="hero-actions">
          <Button href={`mailto:${links.email}`} primary arrow>{cta.primary}</Button>
          <Button href={links.linkedin} target="_blank" rel="me noopener">{cta.secondary}</Button>
        </div>

        <MetricStrip metrics={thesis.data.featured.metrics} variant="hero" />
        <p class="hero-metric-caption">{hero.metricsCaption}</p>
      </div>

      <div class="hero-portrait">
        <Image
          src={hero.portrait.src}
          alt={hero.portrait.alt}
          width={220}
          height={275}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</header>
