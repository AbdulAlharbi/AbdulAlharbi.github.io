---
/** Closing call to action. Same buttons as the hero, same data. */
import './Contact.css';
import Section from '../Section.astro';
import Button from '../Button.astro';
import EmailReveal from '../EmailReveal.astro';
import { getSite } from '../../lib/content';

const { contact, links, cta } = await getSite();
---

<Section id="contact" class="contact" bare>
  <div class="reveal">
    <h2 id="contact-h" class="serif" set:html={contact.heading} />
    <p class="contact-sub">{contact.sub}</p>
    <div class="contact-links">
      <EmailReveal
        id="contact-email"
        label={cta.primary}
        email={links.email}
        panel={cta.emailPanel}
      />
      <Button href={links.linkedin} target="_blank" rel="me noopener">{cta.secondary}</Button>
    </div>
  </div>
</Section>
