---
/** The thesis card: label, title, context and repository link, metrics, tags. */
import './FeaturedResearch.css';
import InlineLink from './InlineLink.astro';
import MetricStrip from './MetricStrip.astro';
import TagList from './TagList.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { title, context, period, description, tags, featured } = entry.data;
if (!featured) throw new Error(`Research entry "${entry.id}" has no featured block`);
---

<article class="featured reveal">
  <div class="featured-label">{featured.label}</div>
  <h3 class="serif">{title}</h3>
  <p class="featured-context">
    <span>{context} · {period}</span> &nbsp;·&nbsp; <InlineLink href={featured.link.url}>{featured.link.label}</InlineLink>
  </p>
  <p class="featured-desc" set:html={description} />
  <MetricStrip metrics={featured.metrics} variant="featured" />
  <TagList tags={tags} />
</article>
