---
/**
 * Link styled as a button. `primary` is the filled accent variant; `arrow`
 * appends the animated arrow. Any other attribute (target, rel, onclick)
 * passes through to the anchor.
 */
import './Button.css';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  primary?: boolean;
  arrow?: boolean;
}

const { primary = false, arrow = false, class: className, ...rest } = Astro.props;
---

<a class:list={['btn', { 'btn-primary': primary }, className]} {...rest}>
  {arrow ? <span><slot /></span> : <slot />}
  {arrow && <span class="arr" aria-hidden="true">→</span>}
</a>
