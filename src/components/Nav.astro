---
/** Primary navigation. Items come from the section registry in site.yaml. */
import './Nav.css';
import { getSite } from '../lib/content';

const site = await getSite();
const items = site.sections.filter((s) => s.nav);
---

<div class="nav-wrap">
  <nav class="nav" aria-label="Primary">
    <a class="nav-brand" href="#top">{site.name.short}</a>
    <ul class="nav-links">
      {items.map((s) => (
        <li class:list={{ 'nav-optional': !s.navMobile }}><a href={`#${s.id}`}>{s.title}</a></li>
      ))}
    </ul>
  </nav>
</div>
