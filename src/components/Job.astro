---
/**
 * One position: dates, role, organisation, bullet points, optional image.
 *
 * The image sizes are multiples of 459, one third of the source's 2754x1488
 * reduced to 459x248, so every generated candidate has an exact integer
 * height and the same aspect ratio. Browsers size the box from the chosen
 * candidate, so this keeps the layout identical across candidates and
 * reserves the exact box before the lazy load (no layout shift on phones).
 */
import './Job.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  job: CollectionEntry<'experience'>['data'];
}

const { role, org, dates, bullets, image } = Astro.props.job;
---

<div class:list={['job', { 'job--has-image': !!image }]}>
  <div class="job-date">{dates.start} — {dates.end}</div>
  <div class="job-body">
    <h3>{role}</h3>
    <p class="job-org">{org}</p>
    <ul>
      {bullets.map((b) => <li set:html={b} />)}
    </ul>
  </div>
  {
    image && (
      <div class="job-image">
        <Image
          src={image.src}
          alt={image.alt}
          width={1377}
          height={744}
          widths={[459, 918, 1377]}
          sizes="(max-width: 720px) calc(100vw - 3rem), 238px"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</div>
